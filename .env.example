# PayPerQ (ppq.ai) — OpenAI-compatible aggregator that routes to Anthropic models.
# Model IDs use dots not dashes here (e.g. `claude-opus-4.7`, `claude-sonnet-4.6`).
PPQ_API_KEY=
PPQ_BASE_URL=https://api.ppq.ai/v1

# Gmail OAuth — credentials.json downloaded from Google Cloud Console
GMAIL_CREDENTIALS_PATH=data/credentials.json
GMAIL_TOKEN_PATH=data/gmail_token.json

# Google Sheets
GOOGLE_SERVICE_ACCOUNT_PATH=data/service_account.json
CAPACITY_SHEET_ID=

# Slack
SLACK_WEBHOOK_URL=

# Agency identity
AGENCY_INTERNAL_DOMAIN=
AGENCY_NAME=
